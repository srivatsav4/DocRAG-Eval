# Copy to .env (never commit .env). No paid API keys are needed anywhere in this project.
PG_DOCS_VERSION=16
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDER_BACKEND=sentence-transformers   # or: hash (non-semantic, smoke tests only)
RERANKER_BACKEND=cross-encoder           # or: lexical (fallback, smoke tests only)
DENSE_BACKEND=auto                       # auto | numpy | pgvector
POSTGRES_USER=docrag
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=docrag
DATABASE_URL=postgresql://docrag:change-me-locally@localhost:5432/docrag
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_ENABLED=true
SEED=42
API_URL=http://localhost:8000
